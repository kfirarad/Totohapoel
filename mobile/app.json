{
  "expo": {
    "name": "Group Bet",
    "slug": "group-bet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "groupbet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kfirarad.groupbet",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:groupbet.kfir.app"
      ],
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "he",
          "en"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563eb",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kfirarad.groupbet",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "groupbet.kfir.app",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563eb",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": [
            "he",
            "en"
          ]
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.897800971628-4lhsjdilvh683f53hgebvm0gl7ftqe8j"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your profile or group",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "kfir",
    "extra": {
      "supportsRTL": true,
      "eas": {
        "projectId": "982f715d-357a-4765-a718-6d060de07913"
      }
    }
  }
}
