{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "admin",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd admin && bun --hot dev.ts"
      ],
      "port": 5174
    },
    {
      "name": "admin-local",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "export BUN_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 BUN_PUBLIC_SUPABASE_KEY=$(bunx supabase status -o json | jq -r .ANON_KEY) PORT=5175; cd admin && bun --hot dev.ts"
      ],
      "port": 5175
    }
  ]
}